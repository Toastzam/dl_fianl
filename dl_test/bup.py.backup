import torch
import numpy as np
from torch.utils.data import DataLoader
from tqdm import tqdm
import os
from PIL import Image

# --- 프로젝트 구조에 맞춰 필요한 클래스/함수 임포트 ---
# extract_features.py에서 특징 추출기 설정을 위한 함수 임포트
from extract_features import setup_feature_extractor 
# dataset.py에서 데이터셋 클래스 임포트
from dataset import StanfordDogsDataset 
# dataset.py에서 transforms 함수 임포트 (데이터셋 클래스가 이미 처리하지만, 명시적으로 불러둠)
from dataset import get_simclr_transforms 

# --- 설정 (train.py에서 가져옴, 필요에 따라 조정) ---
# 데이터셋 루트 경로 (Stanford Dogs 데이터셋의 Images 폴더)
DATA_ROOT = 'training/Images' 
# SimCLR 모델의 출력 임베딩 차원 (vit_tiny 사용 시 192)
OUT_DIM = 128 
# 모델 가중치가 저장된 경로
MODEL_PATH = 'models/simclr_vit_dog_model.pth' 
# 모델 훈련 시 사용한 이미지 크기
IMAGE_SIZE = 224
# 특징 추출 시 사용할 배치 크기 (너무 크면 VRAM 부족, 너무 작으면 느려짐)
BATCH_SIZE = 128 
# 추출된 특징 벡터와 이미지 경로를 저장할 파일명
FEATURES_SAVE_FILE = 'db_features.npy'
IMAGE_PATHS_SAVE_FILE = 'db_image_paths.npy'

def extract_and_save_db_features(
    data_root=DATA_ROOT, 
    model_path=MODEL_PATH, 
    out_dim=OUT_DIM, 
    image_size=IMAGE_SIZE, 
    batch_size=BATCH_SIZE,
    features_save_file=FEATURES_SAVE_FILE,
    image_paths_save_file=IMAGE_PATHS_SAVE_FILE
):
    """
    DB 내 모든 강아지 이미지의 특징 벡터를 추출하고 NumPy 파일로 저장합니다.
    """
    # 특징 추출기 및 전처리 트랜스폼 설정
    feature_extractor, preprocess_transform, device = setup_feature_extractor(
        model_path=model_path, out_dim=out_dim, image_size=image_size
    )

    # 데이터셋 로드 (DB의 모든 이미지 사용, sample_ratio = None)
    # 특징 추출 시에는 label은 필요 없지만 dataset 클래스 구조상 포함됩니다.
    # get_simclr_transforms는 이미지를 2개로 증강하므로, 단일 이미지 전처리 트랜스폼을 사용합니다.
    # setup_feature_extractor에서 만든 preprocess_transform을 사용합니다.
    
    # StanfordDogsDataset은 원래 SimCLR용으로 이미지를 2개 증강하므로,
    # 특징 추출을 위해 Dataset을 조금 다르게 로드하거나,
    # __getitem__에서 이미지를 하나만 반환하도록 임시 수정해야 할 수 있습니다.
    # 여기서는 임시로 __getitem__이 첫 번째 증강 이미지와 경로를 반환하도록 가정합니다.
    # 아니면, Dataset을 새로 정의하는 것이 더 명확합니다.

    # 임시 방편으로, StanfordDogsDataset의 transform에 get_simclr_transforms 대신 
    # 단일 이미지용 preprocess_transform을 직접 전달하고 __getitem__을 조정합니다.
    # 가장 좋은 방법은 특징 추출 전용 Dataset을 만드는 것입니다.
    
    # 여기서는 extract_features.py에서 정의한 preprocess_transform을 사용할 것이므로,
    # dataset.py의 __getitem__에서 img1만 가져오도록 (img1, img2, label) -> (img1, img1, label) 형태로
    # 데이터 로더에서 (img1, img2, labels)를 받아서 img1만 사용하는 방식으로 진행하겠습니다.
    
    # StanfordDogsDataset 생성 시 sample_ratio=None으로 전체 데이터셋을 사용합니다.
    # transform은 SimCLR 학습 시 사용했던 get_simclr_transforms를 그대로 사용합니다.
    # get_simclr_transforms는 내부적으로 여러 트랜스폼을 합성하므로, 
    # __getitem__에서 img1만 사용하도록 처리하겠습니다.

    # Dataset 클래스에 sample_ratio=None을 전달하여 모든 이미지 로드
    # 특징 추출 시에는 Label은 필요 없지만, dataset 구조상 반환됩니다.
    
    # get_simclr_transforms는 증강을 2번 하는데, 특징 추출은 증강이 필요 없습니다.
    # 따라서 특징 추출 전용 transforms를 사용합니다.
    # 이미 setup_feature_extractor에서 preprocess_transform을 만들었으므로 그것을 사용합니다.
    
    # Dataset을 수정하지 않고, 이미지를 단일 전처리할 수 있도록 Dataset을 약간 변경합니다.
    # dataset.py의 __getitem__은 img1, img2, label을 반환하는데, 특징 추출 시에는 하나의 이미지만 필요합니다.
    # 따라서, StanfordDogsDataset을 특징 추출용으로 한번 더 감싸거나, __getitem__을 수정해야 합니다.

    # 간단하게 StanfordDogsDataset을 그대로 사용하되, dataloader에서 반환되는 img1만 사용하고,
    # transform으로 preprocess_transform을 직접 전달하는 것이 효율적입니다.
    # StanfordDogsDataset의 transform 인자는 get_simclr_transforms가 아니라,
    # 단일 이미지를 처리하는 preprocess_transform을 기대합니다.
    
    # NOTE: dataset.py의 StanfordDogsDataset은 __getitem__에서 self.transform(image)를 두 번 호출하여 img1, img2를 만듭니다.
    # 특징 추출 시에는 이미지를 한 번만 전처리하면 되므로, StanfordDogsDataset을 약간 변경하거나,
    # 새로운 Dataset 클래스를 정의하는 것이 더 바람직합니다.
    # 여기서는 기존 StanfordDogsDataset을 활용하되, **임시 방편으로 transform으로 preprocess_transform을 전달하고,
    # __getitem__에서 img1만 사용하도록 유도합니다.**

    # 하지만 StanfordDogsDataset의 __getitem__은 img1, img2를 강제합니다.
    # 따라서, **가장 간단하고 정확한 방법은 dataset.py의 StanfordDogsDataset.__getitem__을 일시적으로 수정하는 것입니다.**
    # 또는 특징 추출 전용 Dataset 클래스를 새로 만드는 것입니다.

    # 안전하게, extract_db_features.py 내부에 특징 추출 전용 Dataset을 새로 정의하겠습니다.
    class FeatureExtractionDataset(torch.utils.data.Dataset):
        def __init__(self, root_dir, transform=None):
            self.root_dir = root_dir
            self.transform = transform
            self.image_paths = []

            # 모든 이미지 경로 수집 (StanfordDogsDataset 로직 재활용)
            classes = sorted([d.name for d in os.scandir(root_dir) if d.is_dir()])
            for class_name in classes:
                class_dir = os.path.join(root_dir, class_name)
                for img_name in sorted(os.listdir(class_dir)):
                    if img_name.endswith('.jpg') or img_name.endswith('.jpeg'):
                        self.image_paths.append(os.path.join(class_dir, img_name))
            print(f"DB에 있는 총 {len(self.image_paths)}개의 이미지를 로드할 예정입니다.")

        def __len__(self):
            return len(self.image_paths)

        def __getitem__(self, idx):
            img_path = self.image_paths[idx]
            image = Image.open(img_path).convert('RGB')
            if self.transform:
                image = self.transform(image)
            return image, img_path # 이미지와 경로를 함께 반환

    db_dataset = FeatureExtractionDataset(root_dir=data_root, transform=preprocess_transform)
    db_dataloader = DataLoader(db_dataset, batch_size=batch_size, shuffle=False, num_workers=os.cpu_count() // 2 or 1, pin_memory=True)

    all_features = []
    all_image_paths = []

    print("DB 이미지 특징 벡터 추출 시작...")
    with torch.no_grad(): # 그라디언트 계산 비활성화
        for images, paths in tqdm(db_dataloader, desc="Extracting DB Features"):
            images = images.to(device)
            features = feature_extractor(images)
            all_features.append(features.cpu().numpy())
            all_image_paths.extend(paths) # 경로 리스트에 추가

    # 추출된 특징 벡터들을 하나의 NumPy 배열로 합치기
    final_features_array = np.concatenate(all_features, axis=0)

    # NumPy 파일로 저장
    np.save(features_save_file, final_features_array)
    np.save(image_paths_save_file, np.array(all_image_paths)) # 경로도 저장

    print(f"\n모든 DB 이미지의 특징 벡터 추출 및 저장 완료!")
    print(f"저장된 특징 벡터 파일: {features_save_file} (Shape: {final_features_array.shape})")
    print(f"저장된 이미지 경로 파일: {image_paths_save_file} (총 {len(all_image_paths)}개)")
    print(f"이제 이 파일을 불러와서 사용자 이미지와 유사도를 비교할 수 있습니다.")


if __name__ == "__main__":
    # 이 스크립트를 실행하면 DB 특징 추출이 시작됩니다.
    # 처음 실행할 때만 시간이 좀 걸립니다.
    extract_and_save_db_features()