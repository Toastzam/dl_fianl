# 간단한 백엔드 전용 Dockerfile
FROM python:3.10.6-slim

# 시스템 패키지 설치
RUN apt-get update && apt-get install -y \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 작업 디렉토리 설정
WORKDIR /app

# Python 의존성 설치
COPY ../requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# PyTorch CPU 버전 설치
RUN pip install torch==2.1.0 torchvision==0.16.0 torchaudio==2.1.0 --index-url https://download.pytorch.org/whl/cpu

# OpenMMLab 패키지들 설치
RUN pip install openmim mmcv==2.1.0 mmengine==0.10.7 mmdet==3.2.0 mmpose==1.3.2

# AP-10K 모델 다운로드
RUN mkdir -p /usr/local/lib/python3.10/site-packages/mmpose/.mim/checkpoints && \
    wget -O /usr/local/lib/python3.10/site-packages/mmpose/.mim/checkpoints/hrnet_w32_ap10k_256x256-18aac840_20211029.pth \
    https://download.openmmlab.com/mmpose/animal/hrnet/hrnet_w32_ap10k_256x256-18aac840_20211029.pth

# 앱 파일 복사
COPY backend/ ./backend/
COPY training/ ./training/
COPY docker/.env ./

# 디렉토리 생성
RUN mkdir -p uploads output_keypoints

# 환경 변수 설정
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# 포트 노출
EXPOSE 8001

# 서버 실행
CMD ["python", "backend/simple_main.py"]
