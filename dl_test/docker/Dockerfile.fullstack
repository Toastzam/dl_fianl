# Multi-stage build for Frontend and Backend
FROM node:18-alpine AS frontend-builder

# Set working directory for frontend
WORKDIR /app/frontend

# Copy frontend package files
COPY dl_test/frontend/package*.json ./

# Install frontend dependencies
RUN npm install

# Copy frontend source code
COPY dl_test/frontend/ ./

# Build frontend
RUN npm run build

# Backend stage with Python
FROM python:3.10.6-slim AS backend-builder

# Install build tools
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    cmake \
    make \
    build-essential \
    wget \
    git \
    curl \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Copy Python dependencies file
COPY requirements.txt .

# Upgrade pip before installing packages
RUN pip install --upgrade pip setuptools wheel

# Install PyTorch CPU version (saves space)
RUN pip install torch==2.1.0 torchvision==0.16.0 torchaudio==2.1.0 --index-url https://download.pytorch.org/whl/cpu

# Remove mmcv packages and install requirements.txt
RUN pip uninstall -y mmcv-lite mmcv mmengine mmdet mmpose || true
RUN pip install --no-cache-dir -r requirements.txt

# Compile and install mmcv from source
RUN pip install --no-cache-dir --no-binary mmcv mmcv==2.1.0 -f https://download.openmmlab.com/mmcv/dist/cpu/torch2.1/index.html

# Install OpenMMLab packages
RUN pip install openmim
RUN mim install mmengine==0.10.7 mmdet==3.2.0 mmpose==1.3.2

# Download AP-10K keypoint detection model
RUN mkdir -p /usr/local/lib/python3.10/site-packages/mmpose/.mim/checkpoints
RUN wget -O /usr/local/lib/python3.10/site-packages/mmpose/.mim/checkpoints/hrnet_w32_ap10k_256x256-18aac840_20211029.pth \
    https://download.openmmlab.com/mmpose/animal/ap10k/hrnet_w32_ap10k_256x256-18aac840_20211029.pth

# Clean up
RUN pip cache purge && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Final production stage
FROM python:3.10.6-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libglib2.0-0 \
    nginx \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set working directory
WORKDIR /app

# Copy Python packages from builder stage
COPY --from=backend-builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=backend-builder /usr/local/bin /usr/local/bin

# Copy backend files
COPY dl_test/backend/ ./backend/
COPY dl_test/training/ ./training/
COPY models/ ./models/

# Copy environment file
COPY dl_test/docker/.env ./

# Copy frontend build from frontend-builder
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist

# Copy nginx configuration
COPY dl_test/docker/nginx.conf /etc/nginx/nginx.conf

# Create directories
RUN mkdir -p uploads output_keypoints logs

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Expose ports
EXPOSE 80 8001

# Create startup script
RUN echo '#!/bin/bash\n\
nginx &\n\
python backend/simple_main.py' > /app/start.sh && \
chmod +x /app/start.sh

# Application execution command
CMD ["/app/start.sh"]
